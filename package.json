{
  "name": "xuexitong-ai-assistant",
  "version": "1.0.4",
  "private": true,
  "description": "超星学习通自动化脚本（支持接入各种主流AI模型api）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/api.test.mjs tests/retry.test.mjs && node scripts/check-public.mjs",
    "test:browser": "node tests/public-browser.mjs",
    "test:images": "node tests/verify-image-questions.mjs",
    "start:codex": "node src/bridge.mjs",
    "test:reading": "node tests/verify-topic-reading.mjs && node tests/verify-document-scroll.mjs && node tests/verify-document-reading.mjs",
    "test:video-recovery": "node tests/verify-video-resubmit.mjs && node tests/verify-video-submission-recovery.mjs && node tests/verify-video-quiz-context.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
